// /opt/monitor/alloy/allloy-config.alloy

// ---------- Logs: /var/log/* -> Loki ----------
local.file_match "varlog" {
  path_targets = [{
    __path__ = "/var/log/*",
    job      = "varlog",
    host     = constants.hostname,
  }]

  // skip binary and rotated/compressed files
//  exclude_paths = [
//    "/var/log/wtmp",
//    "/var/log/btmp",
//    "/var/log/lastlog",
//    "/var/log/*.gz",
//    "/var/log/*.xz",
//   "/var/log/*.bz2",
//    "/var/log/*.zip",
//   "/var/log/*-[0-9]*",
//  ]
}

loki.source.file "varlog" {
  targets    = local.file_match.varlog.targets
  forward_to = [loki.write.monitor.receiver]
}

loki.write "monitor" {
  endpoint {
    url = "http://monitor:3100/loki/api/v1/push"
  }
}

// ---------- Metrics -> Prometheus (remote write) ----------
prometheus.exporter.unix "node" {
  enable_collectors = ["systemd"]
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  forward_to      = [prometheus.relabel.host.receiver]
  scrape_interval = "15s"
}

// Alloy's own metrics
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.relabel.host.receiver]
  scrape_interval = "15s"
}

// Normalize instance label to the real hostname
prometheus.relabel "host" {
  forward_to = [prometheus.remote_write.monitor.receiver]

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.remote_write "monitor" {
  endpoint {
    url = "http://monitor:9090/api/v1/write"
  }
}

